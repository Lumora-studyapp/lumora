VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave false on Firebase Spark. Set true only after deploying the callable
# authentication and recovery functions in functions/index.js.
VITE_LUMORA_AUTH_FUNCTIONS=false

# Enables sending and admin inbox access; the feedback menu/form stays visible.
# Set true only after submitFeedback, its rules, and index are deployed.
VITE_FEEDBACK_ENABLED=false

# Optional comma-separated Lumora usernames that can see the admin UI.
# Each administrator also needs roles/{firebaseUid} = { admin: true } in
# Lumora Firestore before privileged writes are permitted by the rules.
VITE_LUMORA_ADMIN_USERNAMES=
