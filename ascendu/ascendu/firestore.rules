rules_version = '2';

// Lumora Firestore rules for the independent StudyGrove migration.
// Deploy manually after reviewing the migration preview:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUsername(username) {
      return signedIn()
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    // Administrators are configured in Firestore rather than copied from a
    // StudyGrove username. Create roles/{firebaseUid} with { admin: true }.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.admin == true;
    }

    function validUsername(username) {
      return username.matches('^[a-z0-9_]{2,20}$');
    }

    function ownsUsernameValue(data) {
      return data.username is string && ownsUsername(data.username);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isFriendParticipant(data) {
      return signedIn()
        && data.userUids is list
        && request.auth.uid in data.userUids;
    }

    function validFriendAccess(ownerUsername, viewerUid, data) {
      let connection = getAfter(/databases/$(database)/documents/friend_connections/$(data.connectionId)).data;
      return signedIn()
        && data.ownerUsername == ownerUsername
        && data.viewerUid == viewerUid
        && connection.status == 'accepted'
        && request.auth.uid in connection.userUids
        && ((connection.requesterUsername == ownerUsername
              && connection.recipientUid == viewerUid)
            || (connection.recipientUsername == ownerUsername
              && connection.requesterUid == viewerUid));
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /usernames/{username} {
      // Username sign-in needs a single mapping lookup before Firebase Auth is
      // established. Prevent collection enumeration while allowing that get.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.uid == request.auth.uid;
      allow update: if ownsUsername(username)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        // Direct username login must be able to add an email to an older
        // mapping, but an existing login address cannot be swapped client-side.
        && (!('email' in resource.data) || request.resource.data.email == resource.data.email);
      allow delete: if ownsUsername(username);
    }

    match /prefs/{username} {
      allow read: if signedIn();
      allow create: if ownsUsername(username)
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ownsUsername(username)
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        // Preserve direct merge transactions for older Lumora prefs that have
        // not been backfilled yet. Once ownerUid exists it cannot be removed or
        // changed; the normal prefs save path adds it on the next full update.
        && ((('ownerUid' in request.resource.data)
              && request.resource.data.ownerUid == request.auth.uid)
            || (!('ownerUid' in resource.data)
              && !('ownerUid' in request.resource.data)));
      allow delete: if ownsUsername(username) || isAdmin();
    }

    match /history/{username} {
      allow read: if signedIn();
      allow write: if ownsUsername(username) || isAdmin();
    }

    match /tasks/{username}/items/{taskId} {
      allow read, delete: if ownsUsername(username);
      allow create, update: if ownsUsername(username)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180;
    }

    match /presence/{username} {
      // Presence is deliberately not listable. Clients fetch the small known
      // set of accepted friends individually, and the access grant is created
      // atomically when a friend request is accepted.
      allow get: if ownsUsername(username)
        || (signedIn() && exists(/databases/$(database)/documents/friend_access/$(username)/viewers/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if ownsUsername(username)
        && request.resource.data.username == username
        && request.resource.data.ts is int
        // Older clients did not send status; retain that narrow transition
        // path while all saved users receive the new bundle.
        && (!('status' in request.resource.data)
          || request.resource.data.status in ['online', 'studying']);
      allow delete: if ownsUsername(username);
    }

    match /friend_connections/{connectionId} {
      allow get, list: if isFriendParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterUid != request.resource.data.recipientUid
        && ownsUsername(request.resource.data.requesterUsername)
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.recipientUsername)).data.uid
          == request.resource.data.recipientUid
        && request.resource.data.userUids is list
        && request.resource.data.userUids.size() == 2
        && request.resource.data.requesterUid in request.resource.data.userUids
        && request.resource.data.recipientUid in request.resource.data.userUids;
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.status == 'accepted'
        && onlyChanges(['status', 'acceptedAt', 'updatedAt']);
      allow delete: if isFriendParticipant(resource.data);
    }

    match /friend_access/{ownerUsername}/viewers/{viewerUid} {
      allow get: if ownsUsername(ownerUsername)
        || (signedIn() && request.auth.uid == viewerUid);
      allow list: if false;
      allow create, update: if validFriendAccess(ownerUsername, viewerUid, request.resource.data);
      allow delete: if ownsUsername(ownerUsername)
        || (signedIn() && request.auth.uid == viewerUid);
    }

    // StudyGrove-compatible aggregate boards are retained. Client-side
    // transactions require signed-in writes until all mutations are moved to
    // trusted functions; this is called out as a compatibility risk in the PR.
    match /leaderboard_weekly/{documentId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_alltime/{documentId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_reward_claims/{documentId} {
      allow read, write: if signedIn();
    }

    match /leaderboard_groups/{groupId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_group_memberships/{username} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /leaderboard_group_invites/{inviteId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_group_invite_inboxes/{username} {
      allow read, write: if signedIn();
    }

    match /announcementSystem/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Reply/reaction counters are still maintained by the client transaction.
      // Limit non-admin mutations to those aggregate fields only.
      allow update: if isAdmin()
        || (signedIn() && onlyChanges(['replyCount', 'reactionCounts']));

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if ownsUsernameValue(request.resource.data)
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 800;
        allow update: if isAdmin()
          || (ownsUsernameValue(resource.data)
            && request.resource.data.username == resource.data.username)
          || (signedIn() && onlyChanges(['reactionCounts']));
        allow delete: if isAdmin() || ownsUsernameValue(resource.data);

        match /reactions/{reactionId} {
          allow read: if signedIn();
          allow create, update: if ownsUsernameValue(request.resource.data);
          allow delete: if ownsUsernameValue(resource.data);
        }
      }

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create, update: if ownsUsernameValue(request.resource.data);
        allow delete: if ownsUsernameValue(resource.data);
      }
    }

    match /adminLog/{documentId} {
      allow read, write: if isAdmin();
    }

    // Existing Lumora collections remain available so no previous data is
    // removed by this UI migration.
    match /class_boards/{documentId} {
      allow read, write: if signedIn();
    }
    match /classes/{code} {
      allow read, create, update: if signedIn();
      allow delete: if isAdmin()
        || (resource.data.owner is string && ownsUsername(resource.data.owner));
    }
    match /rooms/{code} {
      allow read, write: if signedIn();
    }
  }
}
