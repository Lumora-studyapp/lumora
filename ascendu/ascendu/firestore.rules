rules_version = '2';

// Lumora Firestore rules for the independent StudyGrove migration.
// Deploy manually after reviewing the migration preview:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUsername(username) {
      return signedIn()
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    // Administrators are configured in Firestore rather than copied from a
    // StudyGrove username. Create roles/{firebaseUid} with { admin: true }.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.admin == true;
    }

    match /roles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /usernames/{username} {
      // Username sign-in needs a single mapping lookup before Firebase Auth is
      // established. Prevent collection enumeration while allowing that get.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if ownsUsername(username);
    }

    match /prefs/{username} {
      allow read: if signedIn();
      allow write: if ownsUsername(username)
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && (!('ownerUid' in request.resource.data) || request.resource.data.ownerUid == request.auth.uid);
    }

    match /history/{username} {
      allow read: if signedIn();
      allow write: if ownsUsername(username) || isAdmin();
    }

    match /tasks/{username}/items/{taskId} {
      allow read, write: if ownsUsername(username);
    }

    match /presence/{username} {
      allow read: if signedIn();
      allow write: if ownsUsername(username);
    }

    // StudyGrove-compatible aggregate boards are retained. Client-side
    // transactions require signed-in writes until all mutations are moved to
    // trusted functions; this is called out as a compatibility risk in the PR.
    match /leaderboard_weekly/{documentId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_alltime/{documentId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_reward_claims/{documentId} {
      allow read, write: if signedIn();
    }

    match /leaderboard_groups/{groupId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_group_memberships/{username} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
    match /leaderboard_group_invites/{inviteId} {
      allow read, write: if signedIn();
    }
    match /leaderboard_group_invite_inboxes/{username} {
      allow read, write: if signedIn();
    }

    match /announcementSystem/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn();

        match /reactions/{reactionId} {
          allow read, write: if signedIn();
        }
      }

      match /reactions/{reactionId} {
        allow read, write: if signedIn();
      }
    }

    match /adminLog/{documentId} {
      allow read, write: if isAdmin();
    }

    // Existing Lumora collections remain available so no previous data is
    // removed by this UI migration.
    match /class_boards/{documentId} {
      allow read, write: if signedIn();
    }
    match /classes/{code} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.owner != null;
    }
    match /rooms/{code} {
      allow read, write: if signedIn();
    }
  }
}
